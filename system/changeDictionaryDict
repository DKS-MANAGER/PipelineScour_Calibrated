FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      changeDictionaryDict;
}

Cs
{
    boundaryField
    {
        bottom
        {
            type            inletOutlet;
            phi             phip;
            inletValue      uniform 0;
            value           uniform 0;
        }
    }
}

U
{
    boundaryField
    {
        bottom
        {
            type            movingWallVelocity;
            value           uniform (0 0 0);
        }
    }
}

p
{
    boundaryField
    {
        bottom
        {
            type            fixedFluxPressure;
            value           uniform 0;
        }
    }
}

