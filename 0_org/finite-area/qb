/*---------------------------------------------------------------------------*\
  Project     : 2D Pipeline Scour Morphodynamics
  Author      : Divyansh Kumar Singh
  Level       : Postgraduate Research
  Description : Simulation of hydrodynamics and morphodynamic scour around
                a pipeline using the sedExnerFoam solver.
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       areaVectorField;
    location    "0/finite-area";
    object      qb;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions          [0 2 -1 0 0 0 0];

internalField       uniform (0 0 0);

boundaryField
{
    inletFa
    {
        type        zeroGradient;
    }
    outletFa
    {
        type        zeroGradient;
    }
    lateralfrontFa
    {
        type        empty;
    }
    lateralbackFa
    {
        type        empty;
    }
}
