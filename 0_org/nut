/*---------------------------------------------------------------------------*\
  Project     : 2D Pipeline Scour Morphodynamics
  Author      : Divyansh Kumar Singh
  Level       : Postgraduate Research
  Description : Simulation of hydrodynamics and morphodynamic scour around
                a pipeline using the sedExnerFoam solver.
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      nut;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -1 0 0 0 0];

internalField   uniform 6.7e-5;

boundaryField
{
    inlet
    {
        type            calculated;
        value           uniform 6.7e-5;
    }
    outlet
    {
        type            calculated;
        value           uniform 6.7e-5;
    }
    surface
    {
        type            symmetryPlane;
    }
    bottom
    {
        type            nutkWallFunction;
        value           uniform 0;
    }
    cylinder
    {
        type            nutkWallFunction;
        value           uniform 0;
    }
    lateralfront
    {
        type            empty;
    }
    lateralback
    {
        type            empty;
    }
}

