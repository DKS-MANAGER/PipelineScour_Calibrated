// FIX: Added 'saturationType none' (was completely missing).
//
// bedload.H reads saturationType from this dict. With no keyword present,
// saturationType = "" which matches none of the three valid branches:
//   "implicit1D" | "explicit" | "none"
// → falls into the else { FatalError } branch
// → OpenFOAM FatalError raises SIGABRT, caught by trapFpe, printed as SIGFPE.
//
// PHASE 1 (spin-up, bedMotion off): 'none' is correct — qb = qsat directly.
// PHASE 2 (scour, bedMotion on): change to 'explicit' and add Lsat/Tsat.
//   saturationType   explicit;
//   Lsat             5e-3;   // 5 mm — Renaud et al. 2026, Sec 5.2.3
//   Tsat             0.01;   // 0.01 s
FoamFile {
  version 2.0;
  format ascii;
  class dictionary;
  location "constant";
  object bedloadProperties;
}

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

sedimentBed on;
sedimentBedPatches (bottom);

// PHASE 1 (spin-up 0-2s): bedMotion OFF — mesh stays fixed while flow
// develops. Change to 'on' for Phase 2 (2-45s) restart.
bedMotion on;

// Euler explicit (order 0): safe for cold start, no dVsed.oldTime() required.
ABorder 0;

fixedFaPatches (inletFa outletFa);

filterShields on;

saturation { type none; }

bedloadModel {
  type Nielsen;
  alpha 32.0;
  aExp 0.5;
  bExp 1;
  slopeCorrection on;
  gamma 0.1;
  avalanche on;
  Qav 1e-3;
  alphaFiltBeta 0.1;
  NfiltBeta 1;
  coefShields 1;
}

criticalShieldsModel {
  type Soulsby;
  slopeCorrection on;
}

morphoAccFactor 30.0;
maxDH 1e-5;

// Suppress downstream deposition mound — only scour is physical in
// this short-duration experiment. Bed can only move downward.
noDeposition true;

filterExner on;
alphaFiltExner 0.05;
NfiltExner 2;

rigidBed off;

